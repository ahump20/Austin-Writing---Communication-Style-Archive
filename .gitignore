# Python
__pycache__/
*.pyc
*.pyo

# Local X/Twitter archive source files. Commit processed findings deliberately.
*.zip
X-Twitter-Archive/source/*
!X-Twitter-Archive/source/README.md

# Live X feed capture can generate large raw GraphQL pages. Commit the cleaned
# rows and analysis, not every transient feed response.
X-Twitter-Archive/live-capture/**/page-*.json
X-Twitter-Archive/live-capture/**/response-*.json
X-Twitter-Archive/live-capture/**/*.endpoint.json
X-Twitter-Archive/live-capture/**/capture-state.json
X-Twitter-Archive/live-capture/**/*-capture-tweets.json
X-Twitter-Archive/live-capture/**/*-capture-summary.json

# Private communication source material and local-only audits. Commit only
# privacy-safe aggregate summaries.
Voice-Style-Identity/imessage-analysis/local-private/
Voice-Style-Identity/imessage-analysis/**/*raw*
Voice-Style-Identity/imessage-analysis/**/*verbatim*
Voice-Style-Identity/imessage-analysis/**/*samples*
Voice-Style-Identity/imessage-analysis/**/*transcript*
